<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The brand colours, kept on the surfaces outside the app that carry its identity: the
         launcher icon and the notification. In the app, colour comes from the dynamic scheme. -->
    <color name="icon_background">#0A0A0A</color>
    <color name="accent">#C8F135</color>

    <!-- The dynamic scheme's light surface, which Material 3 reads from this token. -->
    <color name="window_background">@android:color/system_surface_light</color>
</resources>
