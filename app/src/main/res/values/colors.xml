<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The brand colours, kept on the surfaces outside the app that carry its identity: the
         launcher icon and the notification. In the app, colour comes from the dynamic scheme. -->
    <color name="icon_background">#0A0A0A</color>
    <color name="accent">#C8F135</color>

    <!-- Near the dynamic scheme's light surface (tone 98), so there is no flash on cold start.
         Android 14 exposes that surface itself: see values-v34. -->
    <color name="window_background">@android:color/system_neutral1_10</color>
</resources>
